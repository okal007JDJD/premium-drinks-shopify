<section class="section page-width narrow-page">
  <nav class="breadcrumbs"><a href="{{ routes.root_url }}">Home</a><span>/</span><span>{{ page.title }}</span></nav>
  <header class="info-hero"><span class="modal-kicker">Help centre</span><h1>{{ page.title }}</h1><p>{{ section.settings.intro }}</p></header>
  <div class="faq-list">{% for block in section.blocks %}<details class="product-accordion" {{ block.shopify_attributes }}><summary>{{ block.settings.question }} {% render 'icon', name:'chevron', size:16 %}</summary><div class="rte"><p>{{ block.settings.answer }}</p></div></details>{% endfor %}</div>
</section>
{% schema %}{"name":"FAQ page","settings":[{"type":"textarea","id":"intro","label":"Intro","default":"Answers to common questions about ordering, delivery and responsible retailing."}],"blocks":[{"type":"faq","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"How does delivery work?"},{"type":"textarea","id":"answer","label":"Answer","default":"Delivery windows and fees are shown during checkout. Update this answer with your final delivery policy before launch."}]}],"max_blocks":20,"presets":[{"name":"FAQ page","blocks":[{"type":"faq"},{"type":"faq","settings":{"question":"What eligibility checks apply?","answer":"Customers must meet the legal age and any licence or permit requirements that apply in the delivery area."}},{"type":"faq","settings":{"question":"Can I change or cancel an order?","answer":"Add your final order-change and cancellation policy here."}},{"type":"faq","settings":{"question":"How can I contact support?","answer":"Use the Contact page or the phone and email shown in the site footer."}}]}]}{% endschema %}
