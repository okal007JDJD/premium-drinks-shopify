<section class="section section--soft" style="padding-top:34px;padding-bottom:34px">
  <div class="page-width"><div class="value-strip">
    {% for block in section.blocks %}<div class="value-item" {{ block.shopify_attributes }}>{% render 'icon', name:block.settings.icon, size:30 %}<div><strong>{{ block.settings.heading }}</strong><span>{{ block.settings.text }}</span></div></div>{% endfor %}
  </div></div>
</section>
{% schema %}
{
 "name":"Value strip",
 "blocks":[{"type":"item","name":"Item","settings":[{"type":"select","id":"icon","label":"Icon","options":[{"value":"truck","label":"Truck"},{"value":"shield","label":"Shield"},{"value":"gift","label":"Gift"},{"value":"clock","label":"Clock"}],"default":"truck"},{"type":"text","id":"heading","label":"Heading","default":"Fast delivery"},{"type":"text","id":"text","label":"Text","default":"Convenient delivery windows"}]}],
 "max_blocks":4,
 "presets":[{"name":"Value strip","blocks":[{"type":"item"},{"type":"item","settings":{"icon":"shield","heading":"Secure checkout","text":"Safe online payments"}},{"type":"item","settings":{"icon":"gift","heading":"Great offers","text":"Fresh deals every week"}},{"type":"item","settings":{"icon":"clock","heading":"Shop anytime","text":"Open online 24/7"}}]}]
}
{% endschema %}
