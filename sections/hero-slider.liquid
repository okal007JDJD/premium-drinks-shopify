<section class="hero-carousel" data-hero-carousel data-autoplay="{{ section.settings.autoplay_seconds | times: 1000 }}">
  <div class="hero-carousel__track">
    {% for block in section.blocks %}
      <div class="hero-carousel__item" {{ block.shopify_attributes }}>
        <div class="hero">
          <div class="hero__slide">
            <div class="hero__media">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', widths:'720,960,1280,1600,2000,2400', sizes:'100vw', alt:block.settings.heading }}
              {% else %}
                <div class="hero__placeholder"></div>
              {% endif %}
            </div>
            <div class="hero__overlay"></div>
            <div class="page-width" style="display:contents">
              <div class="hero__content" style="margin-left:max(24px, calc((100vw - var(--page))/2))">
                {% if block.settings.eyebrow != blank %}<p class="hero__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
                <h1>{{ block.settings.heading }}</h1>
                {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
                <div class="hero__buttons">
                  {% if block.settings.button_label != blank %}<a class="btn" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_label }}</a>{% endif %}
                  {% if block.settings.button_2_label != blank %}<a class="btn btn--light" href="{{ block.settings.button_2_link }}">{{ block.settings.button_2_label }}</a>{% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    {% else %}
      <div class="hero-carousel__item"><div class="hero"><div class="hero__slide"><div class="hero__placeholder"></div><div class="hero__overlay"></div><div class="hero__content" style="margin-left:max(24px, calc((100vw - var(--page))/2))"><p class="hero__eyebrow">Delivered chilled</p><h1>Good times, delivered.</h1><p>Discover wines, spirits, beer and more — ready when you are.</p><a class="btn" href="{{ routes.all_products_collection_url }}">Shop now</a></div></div></div></div>
    {% endfor %}
  </div>
  {% if section.blocks.size > 1 %}
    <div class="hero-carousel__nav" aria-label="Hero slides">
      {% for block in section.blocks %}<button class="hero-dot{% if forloop.first %} is-active{% endif %}" aria-label="Go to slide {{ forloop.index }}"></button>{% endfor %}
    </div>
  {% endif %}
</section>
{% schema %}
{
  "name":"Hero slider",
  "settings":[{"type":"range","id":"autoplay_seconds","min":3,"max":10,"step":1,"unit":"s","label":"Autoplay speed","default":6}],
  "blocks":[{"type":"slide","name":"Slide","settings":[
    {"type":"image_picker","id":"image","label":"Banner image"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Delivered chilled"},
    {"type":"text","id":"heading","label":"Heading","default":"Good times, delivered."},
    {"type":"textarea","id":"text","label":"Text","default":"A premium drinks shop built for fast, simple home delivery."},
    {"type":"text","id":"button_label","label":"Button label","default":"Shop now"},{"type":"url","id":"button_link","label":"Button link"},
    {"type":"text","id":"button_2_label","label":"Second button","default":"View offers"},{"type":"url","id":"button_2_link","label":"Second link"}
  ]}],
  "max_blocks":5,
  "presets":[{"name":"Hero slider","blocks":[{"type":"slide"},{"type":"slide","settings":{"eyebrow":"Weekend offers","heading":"Stock up. Save more.","text":"Fresh offers across your favourite categories.","button_label":"Shop offers"}}]}]
}
{% endschema %}
