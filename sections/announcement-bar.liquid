{% if section.settings.show %}
  <div class="announcement">
    <div class="announcement__inner page-width">
      <div class="announcement__message">
        {% if section.settings.icon != blank %}<span aria-hidden="true">{{ section.settings.icon }}</span>{% endif %}
        {% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{{ section.settings.text }}</a>{% else %}<span>{{ section.settings.text }}</span>{% endif %}
      </div>
      {% if section.settings.side_text != blank %}<span class="announcement__side">{{ section.settings.side_text }}</span>{% endif %}
    </div>
  </div>
{% endif %}
{% schema %}
{
  "name":"Announcement bar",
  "settings":[
    {"type":"checkbox","id":"show","label":"Show announcement","default":true},
    {"type":"text","id":"icon","label":"Icon / emoji","default":"●"},
    {"type":"text","id":"text","label":"Text","default":"Fast delivery across Dubai — eligibility checks may apply"},
    {"type":"url","id":"link","label":"Link"},
    {"type":"text","id":"side_text","label":"Desktop side text","default":"Shop responsibly · 21+"}
  ]
}
{% endschema %}
