<section class="section page-width"><nav class="breadcrumbs"><a href="{{ routes.root_url }}">Home</a><span>/</span><span>Collections</span></nav><header class="collection-header"><div><h1>{{ section.settings.heading }}</h1><div class="collection-meta">Browse every category</div></div></header><div class="category-grid collection-list-grid">{% for collection in collections %}{% unless collection.handle == 'frontpage' %}<a class="category-card" href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url:width:720 | image_tag:loading:'lazy', alt:collection.title }}{% else %}<div class="category-card__fallback"></div>{% endif %}<span class="category-card__title">{{ collection.title }}</span></a>{% endunless %}{% endfor %}</div></section>{% schema %}{"name":"Collection list","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop all categories"}]}{% endschema %}