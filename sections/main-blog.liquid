<section class="section page-width"><nav class="breadcrumbs"><a href="{{ routes.root_url }}">Home</a><span>/</span><span>{{ blog.title }}</span></nav><header class="collection-header"><div><h1>{{ blog.title }}</h1></div></header>{% paginate blog.articles by 12 %}<div class="editorial-grid">{% for article in blog.articles %}<article class="editorial-card"><a href="{{ article.url }}">{% if article.image %}{{ article.image | image_url:width:900 | image_tag:loading:'lazy', alt:article.title }}{% endif %}<div><small>{{ article.published_at | date:'%d %b %Y' }}</small><h2>{{ article.title }}</h2><p>{{ article.excerpt_or_content | strip_html | truncate:150 }}</p></div></a></article>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}</section>{% schema %}{"name":"Blog"}{% endschema %}