<article class="section page-width article-page"><nav class="breadcrumbs"><a href="{{ routes.root_url }}">Home</a><span>/</span><a href="{{ blog.url }}">{{ blog.title }}</a><span>/</span><span>{{ article.title }}</span></nav><header class="info-hero"><small>{{ article.published_at | date:'%d %b %Y' }}</small><h1>{{ article.title }}</h1></header>{% if article.image %}<div class="article-hero">{{ article.image | image_url:width:1800 | image_tag:widths:'700,1100,1500,1800', sizes:'100vw', alt:article.title }}</div>{% endif %}<div class="rte article-content">{{ article.content }}</div></article>{% schema %}{"name":"Article"}{% endschema %}