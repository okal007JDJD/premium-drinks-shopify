{% liquid
  assign featured_collection = section.settings.collection
  if featured_collection == blank and product != blank
    assign featured_collection = product.collections.first
  endif
  if featured_collection == blank
    assign featured_collection = collections.all
  endif
  assign filter_tag = section.settings.tag_filter | strip
%}

<section class="reference-deals-section" data-product-rail>
  <div class="page-width reference-deals-shell">
    <div class="reference-deals-head">
      <div class="reference-deals-head__copy">
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
      </div>

      <div class="reference-deals-head__actions">
        <div class="reference-rail-arrows" aria-label="Product carousel controls">
          <button class="reference-rail-arrow" type="button" data-rail-prev aria-label="Previous products">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="reference-rail-arrow" type="button" data-rail-next aria-label="Next products">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>

        {% if filter_tag != blank %}
          <a class="reference-deals-see-all" href="{{ routes.all_products_collection_url }}/{{ filter_tag | handleize }}">See all</a>
        {% elsif featured_collection != blank %}
          <a class="reference-deals-see-all" href="{{ featured_collection.url }}">See all</a>
        {% endif %}
      </div>
    </div>

    <div class="reference-product-rail" data-product-rail-track>
      {% assign shown = 0 %}
      {% if featured_collection != blank %}
        {% for product in featured_collection.products %}
          {% if filter_tag == blank or product.tags contains filter_tag %}
            {% render 'product-card', product: product %}
            {% assign shown = shown | plus: 1 %}
            {% if shown >= section.settings.products_to_show %}{% break %}{% endif %}
          {% endif %}
        {% endfor %}
      {% endif %}

      {% if shown == 0 %}
        {% for i in (1..5) %}
          <article class="product-card reference-product-card">
            <div class="reference-card__media-wrap">
              <button class="reference-wishlist" type="button" disabled aria-label="Wishlist available after product import">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div class="product-card__media reference-card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</div>
            </div>
            <div class="product-card__body reference-card__body">
              <h3 class="product-card__title reference-card__title">Sample product {{ i }}</h3>
              <p class="reference-card__stock" aria-hidden="true">&nbsp;</p>
              <div class="reference-card__sale-meta"><span class="reference-card__compare">AED {{ i | times: 25 | plus: 75 }}.00</span><span class="reference-card__save">10% Off</span></div>
              <div class="reference-card__footer">
                <span class="reference-card__price">AED {{ i | times: 20 | plus: 49 }}.00</span>
                <button class="reference-card__add" type="button" disabled aria-label="Import products to enable add to cart"><span aria-hidden="true">+</span></button>
              </div>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Featured collection",
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"Cheers To Great Deals"},
    {"type":"text","id":"text","label":"Text","default":""},
    {"type":"collection","id":"collection","label":"Collection","info":"Leave blank to use All products."},
    {"type":"text","id":"tag_filter","label":"Optional product tag filter","info":"Example: offers, trending or last-chance."},
    {"type":"range","id":"products_to_show","min":5,"max":15,"step":5,"label":"Products to show","default":10},
    {"type":"checkbox","id":"soft_background","label":"Soft background","default":false}
  ],
  "presets":[{"name":"Featured collection"}]
}
{% endschema %}
