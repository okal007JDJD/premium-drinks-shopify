{% liquid
  assign featured_collection = section.settings.collection
  if featured_collection == blank and product != blank
    assign featured_collection = product.collections.first
  endif
  if featured_collection == blank
    assign featured_collection = collections.all
  endif
  assign filter_tag = section.settings.tag_filter | strip
%}
<section class="section{% if section.settings.soft_background %} section--soft{% endif %}">
  <div class="page-width">
    <div class="section-head">
      <div><h2>{{ section.settings.heading }}</h2>{% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}</div>
      {% if filter_tag != blank %}<a href="{{ routes.all_products_collection_url }}/{{ filter_tag | handleize }}">View all</a>{% elsif featured_collection != blank %}<a href="{{ featured_collection.url }}">View all</a>{% endif %}
    </div>
    <div class="product-grid">
      {% assign shown = 0 %}
      {% if featured_collection != blank %}
        {% for product in featured_collection.products %}
          {% if filter_tag == blank or product.tags contains filter_tag %}
            {% render 'product-card', product: product %}
            {% assign shown = shown | plus: 1 %}
            {% if shown >= section.settings.products_to_show %}{% break %}{% endif %}
          {% endif %}
        {% endfor %}
      {% endif %}
      {% if shown == 0 %}
        {% for i in (1..5) %}
          <article class="product-card"><div class="product-card__media">{{ 'product-' | append: i | placeholder_svg_tag:'placeholder-svg' }}</div><div class="product-card__body"><div class="product-card__vendor">Premium Selection</div><h3 class="product-card__title">Sample product {{ i }}</h3><div class="price"><span class="price__current">AED {{ i | times: 20 | plus: 49 }}.00</span></div><div class="quick-add"><button disabled>Import demo products</button></div></div></article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
 "name":"Featured collection",
 "settings":[
   {"type":"text","id":"heading","label":"Heading","default":"Trending now"},
   {"type":"text","id":"text","label":"Text","default":"Popular picks, ready for delivery."},
   {"type":"collection","id":"collection","label":"Collection","info":"Leave blank to use All products."},
   {"type":"text","id":"tag_filter","label":"Optional product tag filter","info":"Example: offers, trending or last-chance."},
   {"type":"range","id":"products_to_show","min":5,"max":15,"step":5,"label":"Products to show","default":5},
   {"type":"checkbox","id":"soft_background","label":"Soft background","default":false}
 ],
 "presets":[{"name":"Featured collection"}]
}
{% endschema %}
