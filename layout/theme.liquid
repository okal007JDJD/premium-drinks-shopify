<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.brand_color }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {% if settings.favicon != blank %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">{% endif %}
    <title>{{ page_title }}{% if current_tags %} – {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} – Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <style>:root{--brand:{{ settings.brand_color }};--brand-dark:{{ settings.brand_dark_color }};--accent:{{ settings.accent_color }};--page-max:{{ settings.page_width }}px;}</style>
    <script>document.documentElement.classList.remove('no-js');window.themeConfig={moneyFormat:{{ shop.money_format | json }},rootUrl:{{ routes.root_url | json }},cartUrl:{{ routes.cart_url | json }},searchUrl:{{ routes.search_url | json }}};</script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </head>
  <body>
    <a class="skip-link visually-hidden" href="#MainContent">Skip to content</a>
    {% section 'announcement-bar' %}
    {% section 'header' %}
    <main id="MainContent" role="main" tabindex="-1">{{ content_for_layout }}</main>
    {% section 'footer' %}
    {% section 'age-license-gate' %}
    <div id="GlobalBackdrop" class="drawer-backdrop" aria-hidden="true"></div>
    <div class="toast" id="ThemeToast" role="status" aria-live="polite"></div>
  </body>
</html>
